# ─── Server ──────────────────────────────────────────────────────────────────
# Port the game server listens on (serves the API, websockets and, in production, the built client).
PORT=3000
# "production" makes the server serve client/dist and enforces CORS_ORIGIN.
NODE_ENV=development
# Allowed browser origin(s) in production, comma separated. Leave empty in development.
CORS_ORIGIN=https://cityguess.example.com

# ─── Street View ─────────────────────────────────────────────────────────────
# "google" (real Street View, requires the keys below) or "mock" (deterministic test panoramas, dev/tests only).
STREET_VIEW_PROVIDER=google
# Server-side key: used to resolve random city points to real panoramas via the Street View metadata API.
# Enable "Street View Static API" on this key. Restrict it by IP (not by HTTP referrer).
GOOGLE_MAPS_SERVER_KEY=
# Browser key: sent to players to load the Maps JavaScript API (Street View panoramas).
# Enable "Maps JavaScript API" on this key. Restrict it by HTTP referrer to your domain.
GOOGLE_MAPS_BROWSER_KEY=
# Optional shortcut for local development: one key used for both roles when the two above are empty.
GOOGLE_MAPS_API_KEY=

# ─── Persistence (optional) ──────────────────────────────────────────────────
# Postgres connection string (Supabase, Neon, local…). Leave empty to run fully in memory.
# Apply db/migrations/*.sql before starting the server. Use the direct/service connection, never an anon key.
DATABASE_URL=
# Set to "require" when the provider needs TLS (Supabase pooler, Neon…).
DATABASE_SSL=

# ─── Client (Vite, build time) ───────────────────────────────────────────────
# Where the client finds the game server. Leave empty when the server serves the client (same origin).
VITE_SERVER_URL=
